# Chicago Crime Analytics Environment Configuration
CHICAGO_CRIMES_PROFILE=local
CHICAGO_CRIMES_SPARK_MASTER=local[4]
CHICAGO_CRIMES_SPARK_DRIVER_MEMORY=4g
CHICAGO_CRIMES_SPARK_EXECUTOR_MEMORY=2g
CHICAGO_CRIMES_LOG_LEVEL=INFO
# CHICAGO_CRIMES_SPARK_ENABLE_DELTA=false
# CHICAGO_CRIMES_STORAGE_BACKEND=local
# CHICAGO_CRIMES_TABLE_FORMAT=parquet

# Optional Socrata App Token (improves Chicago Open Data API rate limits)
# SOCRATA_APP_TOKEN=

# Optional MinIO / S3A (Phase 3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chicago-crimes

# Optional Kafka (Phase 4)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# KAFKA_CRIME_TOPIC=chicago-crimes.raw
# KAFKA_DLQ_TOPIC=chicago-crimes.dlq
# CHICAGO_CRIMES_STREAM_CHECKPOINT=artifacts/checkpoints/crime_stream

# Optional MLflow (Phase 6)
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional Airflow secret key (Phase 5)
# AIRFLOW_SECRET_KEY=replace-with-local-random-secret

# Optional Google Cloud BigQuery Sandbox (Phase 6, never required locally)
# GCP_PROJECT_ID=
# BQ_DATASET=chicago_crimes_gold
# GOOGLE_APPLICATION_CREDENTIALS=
